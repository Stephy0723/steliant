# ── Discord ──
TOKEN=tu-bot-token
CLIENT_ID=tu-client-id
# OBLIGATORIO EN PRODUCCION, no solo para --dev: lo usa discordGuildService.js
# como guild por defecto en cada operacion de rol/canal/mensaje, y
# provisionWorker.js como fallback si el torneo no trae su propio guildId.
# Sin esto en el VPS, /announce y cualquier operacion sin guildId explicito
# fallan en silencio (solo quedan en el log del proceso).
GUILD_ID=el-id-real-del-servidor-de-glitchgang

# ── API de torneos que ya usaba el bot ──
TOURNAMENT_API_URL=http://localhost:4000/api/bots/tournaments/active
CRM_PORT=3010
# OAuth del CRM del bot. En produccion puede apuntar a:
# CRM_DISCORD_REDIRECT_URI=https://discord.glitchgang.net/auth/discord/callback
# No lo mezcles con DISCORD_AUTH_REDIRECT_URI del backend web principal.
# CRM_DISCORD_REDIRECT_URI=http://localhost:3010/auth/discord/callback

# ── Backend GlitchGang (cerebro IA + API de equipos/torneos/perfil/referidos) ──
# PLATFORM_API_URL solo lo usa el proceso del CRM (api/server.js) para hablar
# directo con el backend real -- esa conexion SI esta permitida (Web<->CRM).
# El proceso del bot (index.js, comandos, eventos y servicios) YA NO le pega
# a esto: pasa por el CRM en CRM_INTERNAL_URL (ver mas abajo), que reenvia
# 1:1 a /api/bots/* usando BOT_API_KEY. No pongas el bot a hablarle a esto
# directo otra vez -- ver "Bot -> CRM -> Backend" en api/server.js.
PLATFORM_API_URL=http://localhost:4000
AI_TIMEOUT_MS=20000

# Secreto compartido con backend/.env (BOT_API_KEY) para autenticar /api/bots/*
# (via el proxy del CRM) y para el puente interno bot<->CRM de mas abajo.
# TIENE QUE SER EL MISMO VALOR EXACTO en discord-bot/.env y backend/.env --
# si no coinciden, checkin/report/vincular fallan con 401 en silencio.
BOT_API_KEY=

# Token que el backend manda en POST /portal/tournaments/sync (crmSync.service.js
# del lado backend) para probar que la sync viene de la web y no de cualquiera.
# Si lo dejas vacio, se reusa BOT_API_KEY de arriba (mismo fallback que usa el
# backend) -- podes dejarlo vacio con confianza, o ponerle un secreto propio.
GLITCHGANG_SITE_TOKEN=

# Donde el proceso del bot encuentra al CRM para su proxy hacia el backend
# (/bot-proxy/*). Por defecto se calcula solo con CRM_PORT; solo hace falta
# si el CRM corre en otro host/puerto distinto al que ve este proceso.
# CRM_INTERNAL_URL=http://127.0.0.1:3010

# El canal de bienvenida/despedida ya NO es una variable de entorno — se
# configura por cliente (Organization.welcomeChannelId) via
# POST/PATCH /api/admin/organizations en el backend.

# Dominio publico de la web (para el icono del juego en la bienvenida)
WEBSITE_URL=https://glitchgang.net

# ── Puente interno bot -> CRM (Discord Monitor) ──
# El CRM (api/server.js) corre en OTRO proceso que el bot (index.js) y no
# tiene el Client de discord.js — le pide canales/roles/miembros/voz a este
# servidor interno, que solo escucha en localhost. Reusa BOT_API_KEY como
# secreto. Cambia el puerto solo si 3055 ya esta en uso.
BOT_INTERNAL_PORT=3055

# Bots auxiliares de grabacion. No registran comandos; solo entran a voz.
# Separa varios tokens con coma.
RECORDER_TOKENS=token_grabador_01,token_grabador_02
# Opcional pero recomendado: IDs de aplicacion correspondientes a cada token
# anterior, en el mismo orden. Ayuda a detectar tokens cruzados antes de iniciar.
RECORDER_CLIENT_IDS=client_id_grabador_01,client_id_grabador_02
# ID numerico del rol de Discord que permite a los grabadores ver/conectarse
# a las salas privadas de torneo/equipo.
RECORDER_ROLE_ID=123456789012345678

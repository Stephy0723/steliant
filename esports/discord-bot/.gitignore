# El build real del dashboard (vite outDir) va aqui, no en frontend/dist —
# es un artefacto generado por "npm run dashboard:build", no codigo fuente.
# Trackearlo causaba que cada deploy dejara el arbol de trabajo "sucio" y
# bloqueara el siguiente "git pull" en el VPS.
api/public/app/


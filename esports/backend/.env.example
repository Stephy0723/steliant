PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017/glitchgang

# JWT — usa al menos 64 caracteres aleatorios
JWT_SECRET=replace-with-64-char-random-secret
JWT_EXPIRES_IN=7d

# Redis (opcional — si no está configurado, se usa memoria)
REDIS_URL=redis://localhost:6379

# SMTP (Gmail recomendado con App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@glitchgang.gg

# CSRF
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token

# Cookie de autenticación
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Discord OAuth (opcional) -- crear la app en https://discord.com/developers/applications,
# pestaña OAuth2, y agregar este mismo redirect ahí para que Discord la acepte.
# El redirect apunta al BACKEND (donde vive la ruta /api/auth/discord/callback),
# no al frontend -- si apunta al puerto del frontend (5173) el login de Discord
# nunca vuelve a ningún lado real.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth de la web principal. En produccion debe ser:
# DISCORD_AUTH_REDIRECT_URI=https://glitchgang.net/api/auth/discord/callback
# No uses https://discord.glitchgang.net aqui: ese dominio es el CRM del bot.
DISCORD_AUTH_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
# Nombre legacy aceptado por compatibilidad local.
# DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Discord bot — secreto compartido para autenticar llamadas del bot a /api/bots/*
# TIENE QUE SER EL MISMO VALOR EXACTO que BOT_API_KEY en discord-bot/.env --
# si no coinciden, checkin/report/vincular fallan con 401 en silencio.
BOT_API_KEY=

# ID del servidor real de Discord de GlitchGang -- usado como guild por
# defecto cuando el torneo aun no tiene su propio discordProvision.guildId
# (crmSync.service.js, tournament.controller.js). Mismo servidor que GUILD_ID
# en discord-bot/.env.
DISCORD_GUILD_ID=

# URL del CRM del bot (proceso api/server.js de discord-bot/) al que el
# backend le manda POST /portal/tournaments/sync para arrancar el
# aprovisionamiento de Discord de un torneo. En el VPS, con ambos procesos
# en la misma maquina, suele ser http://127.0.0.1:<CRM_PORT del bot>.
CRM_PORTAL_URL=http://localhost:3010

# Token que el backend manda en ese POST /portal/tournaments/sync para
# probar que la sync viene de la web. Si lo dejas vacio, se reusa
# BOT_API_KEY de arriba -- mismo fallback del lado del bot, podes dejarlo
# vacio con confianza.
GLITCHGANG_SITE_TOKEN=

# Microsoft Azure Entra ID — verificación institucional universitaria (opcional)
# Regístrate en portal.azure.com → App registrations → New registration
# Redirect URI: http://localhost:4000/api/university/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/university/microsoft/callback
# Tenant: "common" acepta cualquier cuenta institucional, o pon tu tenant ID específico
MICROSOFT_TENANT_ID=common

# Reglas de verificación universitaria adicionales (JSON, opcional)
# Ejemplo: {"uasd":{"allowedDomains":["uasd.edu.do"],"allowedTenantIds":["xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"]}}
UNIVERSITY_VERIFICATION_RULES_JSON=

# DEV ONLY — salta la validación de dominio institucional para pruebas locales
# NUNCA poner true en producción
UNIVERSITY_DEV_BYPASS=false

# Pagos — PayPal es la pasarela real (Stripe no opera en Rep. Dominicana).
# Crear la app en https://developer.paypal.com/dashboard/applications, cuenta
# business real con Guest Checkout (PayPal Account Optional) activado.
# Sin estas dos, /payments corre en modo DEMO (no cobra nada de verdad).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" cuando la app de PayPal esté aprobada para producción; cualquier otro
# valor (o vacío) usa el sandbox de pruebas.
PAYPAL_ENV=sandbox
# Developer Dashboard → tu app → Webhooks → agregar
# https://tu-dominio/api/payments/webhook/paypal (opcional, es una red de
# seguridad ademas de la captura server-to-server que ya hace el checkout).
PAYPAL_WEBHOOK_ID=

# Stripe quedó descartado como pasarela (no opera en RD), pero el webhook
# está listo si algún día se reactiva.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# GG (asistente virtual). Clave gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Estadísticas desde capturas: siempre requieren confirmación humana.
# Vacío usa GEMINI_MODEL; false desactiva solo la lectura IA, no la entrada manual.
GEMINI_STATS_MODEL=
MATCH_STATS_VISION_ENABLED=true
MATCH_STATS_TIMEOUT_MS=45000
MATCH_STATS_REQUESTS_PER_MINUTE=4
# Repara historiales pendientes de fichas YA confirmadas; nunca confirma borradores.
MATCH_STATS_REPAIR_ENABLED=true
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.0-flash-lite

# Verificacion de cuentas de Mobile Legends (codigo al correo dentro del juego).
# API comunitaria Rone Arena, no oficial. Ver backend/src/services/gameAccount.service.js
GAME_ACCOUNT_VERIFY_ENABLED=true
GAME_ACCOUNT_VERIFY_URL=https://arena.rone.dev/api
GAME_ACCOUNT_VERIFY_TIMEOUT_MS=12000
# Si el servicio responde 503 con otro host, solo se sigue si es *.rone.dev o esta aqui (coma).
GAME_ACCOUNT_VERIFY_ALT_HOSTS=

# Grabaciones de voz de /start-match (services/matchRecordings.service.js).
# Carpeta privada (NO /uploads, que es publico). Vacio = backend/data/recordings.
# scripts/backup.sh la respalda (lee esta misma variable). Ruta relativa = desde backend/.
MATCH_RECORDINGS_DIR=
# "Si no hay reclamos, se elimina a los 30 dias" (aviso del bot en la sala).
MATCH_RECORDINGS_RETENTION_DAYS=30
MATCH_RECORDINGS_MAX_TRACK_MB=200

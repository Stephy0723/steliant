# URL del backend (incluye /api)
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Conectar el frontend al backend real.
# false = modo prototipo (datos locales). true = usa el backend (multi-dispositivo).
VITE_USE_BACKEND=false

# Clave pública de Stripe (para el checkout en el navegador). Opcional hasta integrar pagos.
VITE_STRIPE_PUBLIC_KEY=

# CRM del bot de Discord (Centro de Torneos). En local el bot expone su API
# en localhost:3001; en produccion apunta al dominio real del CRM.
VITE_CRM_URL=http://localhost:3001

